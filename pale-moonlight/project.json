  "dialogues": {
    "garak": [
      {
        "label": "Can your old contacts obtain Dominion intelligence?",
        "requires": [
          "assessment"
        ],
        "lines": [
          [
            "sisko",
            "I need evidence of the Dominion's intentions toward Romulus. Evidence their government will believe."
          ],
          [
            "garak",
            "My former acquaintances are not accustomed to requests from Starfleet captains."
          ],
          [
            "sisko",
            "Then ask as a tailor. I need to know whether there is a way."
          ],
          [
            "garak",
            "I can make inquiries. I would advise you to decide how far you are prepared to follow the answers."
          ]
        ],
        "sets": [
          "complete"
        ]
      },
      {
        "label": "Why keep a shop open during a war?",
        "lines": [
          [
            "garak",
            "Because people continue to tear their sleeves, Captain. Some problems remain pleasingly simple."
          ]
        ]
      },
      {
        "label": "I need to finish my assessment.",
        "requires": [
          "!assessment"
        ],
        "lines": [
          [
            "sisko",
            "I should bring you something more useful than speculation."
          ],
          [
            "garak",
            "An excellent habit. I hope you will be able to maintain it."
          ]
        ]
      },
      {
        "label": "That is all for now.",
        "lines": []
      }
    ]
  },
